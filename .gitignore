# 上游镜像：上百 MB 的对象库，绝不入库
upstream-mirrors/
*.git/

# 运行环境资产：分层 bundle，从公开来源获取或离线导入，不入库。
# 前导斜杠是必须的：不带斜杠的 runtime/ 会匹配任意层级的同名目录，
# 而上游有 4 个名为 runtime 的源码包（app/src/main/java/com/dshfusion/app/runtime/
# 等，共 22 个文件），会被静默吞掉、不进提交、克隆后构建失败。
/runtime/
/runtime/android-assets/
/dist/
*.tar.zst
*.tar.gz
*.tar.xz
offline-rootfs.bin
dsh-runtime.bin
ubuntu-tools.bin
pnpm-runtime.bin
python-support.bin
glibc-python.tar.gz

# Android / Gradle 构建产物
.gradle/
build/
app/build/
*/build/
captures/
*.apk
*.ap_
# tools/run-backup-jvm-tests.sh 的依赖与编译产物缓存（1.4 MB）。
# 前导斜杠是必须的：它是仓库根下的固定位置，而 tools 里若出现同名目录不该被一起忽略。
# 2026-10-14 实测：没有这一条时 `git add -A` 会把 4 个 jar 与 53 个 .class 一起暂存
# （57 个文件），而既有的「大资产不入库」断言只匹配 *.tar.zst/*.gz，**抓不到 jar**。
/.jvm-test-cache/
# *.aar 排除的是构建产物；但上游刻意 vendored 了 libs/zstd-jni-1.5.7-15.aar
# 作为构建依赖（app/build.gradle.kts 引用），必须放行，否则克隆后无法构建。
*.aar
!/libs/*.aar
!/libs/**/*.aar
*.dex
local.properties
.cxx/

# 签名密钥：绝不入库
*.jks
*.keystore
keystore.properties
*.p12
*.pem

# IDE / 编辑器
.idea/
*.iml
.vscode/
.DS_Store

# Python
__pycache__/
*.pyc

# 临时文件
tmp_*/
tmp-*/
/tmp/
*.log
